{
	"name": "plexus-agent-plugins",
	"version": "1.4.10",
	"type": "module",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "bun run --cwd packages/plexus-pi build.ts && bun run --cwd packages/plexus-opencode build.ts && bun run --cwd packages/plexus-oh-my-pi build.ts",
		"test": "bun test",
		"postinstall": "command -v lefthook >/dev/null 2>&1 && lefthook install || true",
		"sync-versions": "bun scripts/sync-versions.ts",
		"release": "bun scripts/release.ts",
		"code:review:staged": "cora review --staged --severity major",
		"code:review:unstaged": "cora review --unstaged --severity major",
		"code:review:branch": "cora review --base origin/main --severity major",
		"code:review:commit": "cora review --commit HEAD --severity major"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"lefthook": "latest"
	},
	"peerDependencies": {
		"typescript": "^5"
	}
}
